<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/purple_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MiBibliotecaPersonal"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnNotificaciones"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="Notificaciones"
                android:padding="10dp"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="¡Hola! 👋"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descubre tu próxima lectura"
            android:textColor="@color/white"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Buscador -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar libros"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etBuscarLibro"
                android:textColor="#212121"
                android:textColorHint="#55515C"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@android:drawable/edit_text"
                android:hint="Título, autor o género..."
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <!-- Acceso a préstamos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@color/purple_light"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📚  Tu biblioteca te espera"
                    android:textColor="@color/purple_dark"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Explora libros, consulta su disponibilidad y organiza tus préstamos."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>

            </LinearLayout>

            <!-- Libros destacados -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Libros destacados"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>


            <!-- Libro 1 -->
            <LinearLayout
                android:id="@+id/cardLibro1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Harry Potter y la piedra filosofal"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="J. K. Rowling"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/purple_light"
                    android:padding="8dp"
                    android:text="Fantasía"
                    android:textColor="@color/purple_dark"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Una aventura mágica que comienza con el descubrimiento de un mundo extraordinario."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnDetallesLibro1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ver detalles"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"/>

            </LinearLayout>

            <!-- Libro 2 -->
            <LinearLayout
                android:id="@+id/cardLibro2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El principito"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Antoine de Saint-Exupéry"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/purple_light"
                    android:padding="8dp"
                    android:text="Fábula"
                    android:textColor="@color/purple_dark"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Una historia sobre la amistad, el amor y las cosas importantes de la vida."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnDetallesLibro2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ver detalles"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/purple_primary"/>

            </LinearLayout>

            <!-- Contenedor para libros de Firebase (agregado para corregir el error contenedorLibros) -->
            <LinearLayout
                android:id="@+id/contenedorLibros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>

    </ScrollView>

    <!-- Navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/purple_primary"
        app:itemTextColor="@color/purple_primary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"/>

</LinearLayout>
